{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "dialog:default",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-write-text",
    "store:default",
    "opener:default"
  ]
}
