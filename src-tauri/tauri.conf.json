{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ImageAreo",
  "version": "0.1.0",
  "identifier": "dev.imageareo.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ImageAreo",
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "gif",
          "webp",
          "avif",
          "tif",
          "tiff",
          "bmp",
          "ico",
          "heic",
          "heif",
          "raw",
          "cr2",
          "cr3",
          "nef",
          "arw",
          "dng",
          "orf",
          "rw2",
          "raf",
          "srw",
          "pef",
          "jxl"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
